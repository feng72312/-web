# CloudBase / production: full backend API prefix (must include /api/v1)
# Example: https://your-service-id.ap-shanghai.tcb-api.tencentcloudapi.com/api/v1
# Local dev: default is http://127.0.0.1:8001/api/v1 (see config.ts LOCAL_DEV_API_BASE)
# Copy to .env.local to override, or leave unset to use that default after rebuild
# VITE_API_BASE=http://127.0.0.1:8001/api/v1

# CloudBase user auth (publishable key is client-safe)
# VITE_CLOUDBASE_ENV_ID=zy-feng-d3glt5d93b1a9f08e
# VITE_CLOUDBASE_REGION=ap-shanghai
# VITE_CLOUDBASE_PUBLISHABLE_KEY=

[Unit]
Description=Bazi public quick tunnel
After=network-online.target bazi-backend.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/feng/.local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8080
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

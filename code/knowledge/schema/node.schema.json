{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeNode",
  "type": "object",
  "required": [
    "id",
    "topic",
    "sourceTier",
    "sourceCategory",
    "sourceFile",
    "lookupKey",
    "summary",
    "claims",
    "agreementLevel",
    "safeAutoAnswer",
    "domain"
  ],
  "properties": {
    "id": { "type": "string" },
    "topic": {
      "type": "string",
      "enum": [
        "tiaohou",
        "shishen",
        "ganzhi",
        "liunian",
        "dayun",
        "wuxing_season",
        "pattern",
        "geju",
        "qishi",
        "suiyun",
        "case",
        "commentary",
        "interactions",
        "yong_shen",
        "topic_divination",
        "wang_shuai",
        "dong_bian",
        "ying_qi",
        "xun_kong",
        "yue_po",
        "fei_fu",
        "shi_ying",
        "casting",
        "gua",
        "ziwei_palace",
        "ziwei_star",
        "ziwei_pattern",
        "ziwei_mutagen",
        "ziwei_palace_topic",
        "ziwei_limit",
        "ziwei_cross_school"
      ]
    },
    "ruleType": { "type": "string" },
    "condition": { "type": "object" },
    "forbidCondition": { "type": "object" },
    "priority": { "type": "integer" },
    "conflictsWith": { "type": "array", "items": { "type": "string" } },
    "confidenceBase": { "type": "number" },
    "sourceScope": { "type": "array", "items": { "type": "string" } },
    "evidenceRole": { "type": "string" },
    "authorityTier": { "type": "string", "enum": ["S", "A", "B", "C", "D"] },
    "sourceTier": { "type": "string", "enum": ["T1", "T2", "T3", "T4"] },
    "sourceCategory": { "type": "string" },
    "sourceFile": { "type": "string" },
    "lookupKey": { "type": "object" },
    "summary": { "type": "string" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["classic", "chapter", "quote", "conclusion", "role", "sourceFile", "sourceCategory"],
        "properties": {
          "classic": { "type": "string" },
          "edition": { "type": "string" },
          "chapter": { "type": "string" },
          "quote": { "type": "string" },
          "conclusion": { "type": "string" },
          "role": { "type": "string", "enum": ["primary", "corroboration", "contradiction"] },
          "aligns": { "type": ["boolean", "null"] },
          "sourceFile": { "type": "string" },
          "sourceCategory": { "type": "string" }
        }
      }
    },
    "agreementLevel": {
      "type": "string",
      "enum": ["unanimous", "majority", "disputed", "single_source"]
    },
    "safeAutoAnswer": { "type": "boolean" },
    "domain": { "type": "string", "enum": ["bazi", "bazi-adjacent", "liuyao", "ziwei"] },
    "school": { "type": "string" },
    "palaceScope": { "type": "array", "items": { "type": "string" } },
    "starScope": { "type": "array", "items": { "type": "string" } },
    "mutagenScope": { "type": "array", "items": { "type": "string" } },
    "libraryRole": { "type": "string" },
    "classic": { "type": "string" },
    "conditions": { "type": "object" },
    "reviewedAt": { "type": ["string", "null"] },
    "reviewerNotes": { "type": "string" }
  }
}

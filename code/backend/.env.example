BAZI_CURSOR_API_KEY=cursor_xxx
BAZI_CURSOR_MODEL=composer-2.5
BAZI_CURSOR_WORKSPACE=
BAZI_DEEPSEEK_API_KEY=sk-xxx
BAZI_DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI interpretation capacity: 5 running + 10 waiting for up to 300 seconds.
BAZI_INTERPRET_MAX_CONCURRENT=5
BAZI_INTERPRET_MAX_WAITING=10
BAZI_INTERPRET_QUEUE_WAIT_SECONDS=300
BAZI_RAG_PROVIDER=http
BAZI_RAG_HTTP_URL=http://127.0.0.1:8100
BAZI_MEIHUA_RAG_CATEGORY=03梅花易学
BAZI_QIMEN_RAG_CATEGORY=04奇门遁甲
BAZI_LIUREN_RAG_CATEGORY=05大六壬
# Local default: backend/data/usage_stats.db (leave empty)
# Cloud: mount COS at /mnt, then set:
# BAZI_STATS_DB_PATH=/mnt/data/usage_stats.db
BAZI_STATS_DB_PATH=
# AI quota license keys (local default: backend/data/quota.db)
# BAZI_QUOTA_DB_PATH=/mnt/data/quota.db
BAZI_QUOTA_DB_PATH=
# Admin console credentials (change in production)
# BAZI_ADMIN_USERNAME=fengge
# BAZI_ADMIN_PASSWORD=your-strong-password
# BAZI_ADMIN_SESSION_TTL_HOURS=24
